<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>MobileDbBenchmark.iOS</RootNamespace>
    <AssemblyName>MobileDbBenchmark.iOS</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>13</LangVersion>

    <!-- Application -->
    <ApplicationId>com.yourcompany.MobileDbBenchmark</ApplicationId>
    <ApplicationTitle>MobileDbBenchmark</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- iOS specific -->
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.0" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="9.0.0" />
    <PackageReference Include="Acr.UserDialogs.Maui" Version="9.2.2" />
    <PackageReference Include="Realm" Version="10.18.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MobileDbBenchamark.Common\MobileDbBenchamark.Common.csproj" />
    <ProjectReference Include="..\MobileDbBenchmark.UI\MobileDbBenchmark.UI.csproj" />
  </ItemGroup>

</Project>