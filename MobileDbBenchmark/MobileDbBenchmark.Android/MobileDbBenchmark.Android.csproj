<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>MobileDbBenchmark.Droid</RootNamespace>
    <AssemblyName>MobileDbBenchmark.Android</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>13</LangVersion>

    <!-- Application -->
    <ApplicationId>MobileDbBenchmark.Android</ApplicationId>
    <ApplicationTitle>MobileDbBenchmark</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Android specific -->
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <AndroidManifest>Properties\AndroidManifest.xml</AndroidManifest>
    <RuntimeIdentifiers>android-arm;android-arm64;android-x86;android-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <AndroidUseSharedRuntime>True</AndroidUseSharedRuntime>
    <AndroidLinkMode>None</AndroidLinkMode>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <AndroidUseSharedRuntime>False</AndroidUseSharedRuntime>
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <AndroidEnableProfiledAot>true</AndroidEnableProfiledAot>
    <AndroidUseDefaultAotProfile>false</AndroidUseDefaultAotProfile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.0" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="9.0.0" />
    <PackageReference Include="Acr.UserDialogs.Maui" Version="9.2.2" />
    <PackageReference Include="Realm" Version="10.18.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MobileDbBenchamark.Common\MobileDbBenchamark.Common.csproj" />
    <ProjectReference Include="..\MobileDbBenchmark.UI\MobileDbBenchmark.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep custom AOT profile -->
    <AndroidAotProfile Include="custom.aprof" />
  </ItemGroup>

</Project>